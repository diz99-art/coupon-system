# 로컬 개발용 환경변수 예시. 복사해서 쓴다: cp .env.example .env  (.env는 git에 올리지 않는다)
# docker compose와 스프링 앱(./gradlew bootRun, 테스트)이 함께 읽는다.
# 이미 만든 MySQL 데이터(docker 볼륨)가 있으면 그때 쓴 비밀번호와 같아야 한다.

# MySQL
DB_USERNAME=coupon
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Grafana 관리자 비밀번호 (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=change-me

# 운영(prod)에서 함께 넣는 값들. 로컬에서는 기본값(localhost)을 쓰므로 비워 둔다.
# DB_HOST=
# DB_PORT=3306
# DB_NAME=coupon
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=true
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_REPLICATION_FACTOR=3
