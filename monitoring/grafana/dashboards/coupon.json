      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(coupon_issue_success_total[$__rate_interval]))",
          "legendFormat": "성공"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(coupon_issue_save_delay_seconds_count[$__rate_interval]))",
          "legendFormat": "DB 저장 (컨슈머)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (reason) (rate(coupon_issue_rejected_total[$__rate_interval]))",
          "legendFormat": "거절: {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Kafka 컨슈머 처리 지연",
      "description": "발급 확정(API 응답)부터 컨슈머가 DB에 저장할 때까지 걸린 시간(p95·최대)과, 토픽에 쌓여 아직 못 읽은 메시지 수(lag)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "쌓인 메시지(lag)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coupon_issue_save_delay_seconds_bucket[$__rate_interval])))",
          "legendFormat": "저장 지연 p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max(coupon_issue_save_delay_seconds_max)",
          "legendFormat": "저장 지연 최대"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(kafka_consumer_fetch_manager_records_lag{topic!~\".*DLT\"})",
          "legendFormat": "쌓인 메시지(lag)"
        }
      ]
    },
    {
      "type": "stat",
      "id": 10,
      "title": "대사 보정 건수",
      "description": "선택한 기간 동안 대사 작업이 채운 발급 (db: Redis에만 있던 것을 DB에 저장, redis: DB에만 있던 것을 Redis에 복구)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
