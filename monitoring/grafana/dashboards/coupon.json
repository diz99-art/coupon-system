      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (target) (max_over_time(coupon_reconcile_corrected_total[$__range]) - min_over_time(coupon_reconcile_corrected_total[$__range]))",
          "legendFormat": "{{target}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 11,
      "title": "대사 작업 실행 횟수 (서버별)",
      "description": "선택한 기간 동안 각 서버가 대사 작업을 실행한 횟수. ShedLock이 있으면 합이 분 수와 같다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (instance) (max_over_time(coupon_reconcile_duration_seconds_count[$__range]) - min_over_time(coupon_reconcile_duration_seconds_count[$__range]))",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "대사 작업 누적 실행 (서버별)",
      "description": "서버별 누적 실행 횟수. 계단이 오른 시각에 그 서버가 실행했다. 같은 분에 두 서버가 함께 오르면 중복 실행이다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (instance) (coupon_reconcile_duration_seconds_count)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "row",
